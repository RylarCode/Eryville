rules_version = '2';

// Nobody can read or write the database from the game or the web: every access goes through the Cloud
// Functions (which use the admin SDK and are not affected by these rules). This is what stops a player from
// editing their own letters, pity or save.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
